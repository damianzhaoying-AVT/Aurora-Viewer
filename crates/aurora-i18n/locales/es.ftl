hud-local-scale-help = Mantén pulsada la tecla HUD: arrastra con el botón izquierdo para moverlo y usa la rueda para cambiar su tamaño; Mayús permite ajustes más finos. El tamaño se guarda en este equipo para esta cuenta, según el nombre y el creador. Al editar un HUD, la rueda sin esta tecla acerca o aleja la vista de todos los HUD.
cli-help = { "Aurora Viewer\u000A\u000AUso: aurora-viewer [--title <texto>] [--fps-limit <fps>] [--vr] [--language <código>] [--grid <nombre>]\u000A                     [--login <nombre> <apellido> <contraseña>] [--version] [--uninstall] [<slurl>]\u000A\u000A  --title <texto>   Nombra esta ventana (\"Aurora Viewer <versión> - <texto>\") y su archivo de registro\u000A                   (aurora-<texto>.log, aurora-demo-<texto>.log en modo de demostración)\u000A  --fps-limit <fps>  Limita este proceso a 1..500 FPS sin guardar las preferencias\u000A  --language <código>  Cambia el idioma de la interfaz de este proceso (" }{ $languages }{ ")\u000A  --grid <nombre>    Inicia en agni, aditi, una cuadrícula guardada o una URI de inicio de sesión (también --loginuri <uri>)\u000A  --login <nombre> <apellido> <contraseña>  Inicia sesión de inmediato con esta cuenta\u000A  <slurl>, --url <slurl>  Inicia en este lugar; no se lee nada que aparezca después. Si ya hay un visor\u000A                   en ejecución, recibe la dirección en su lugar\u000A  --vr             Entra en VR cuando aparezca el mundo (con los auriculares conectados)\u000A  -V, --version   Muestra la versión compilada del visor sin iniciarlo\u000A  --uninstall      Elimina lo que Aurora registró fuera de sus carpetas (asociador de enlaces,\u000A                   almacén de credenciales y complemento de Blender), lo muestra junto con las carpetas restantes y sale\u000A  -h, --help       Muestra esta ayuda\u000A\u000ALas opciones de prueba son variables de entorno (AURORA_DEMO=1, AURORA_CAPTURE=...):\u000Aconsulta README.md." }
demo-media-page = { "data:text/html;charset=utf-8,<html><body style='margin:0;height:100vh;background:linear-gradient(135deg,%232a1f4a,%230f6d6d);color:white;font:56px sans-serif;text-align:center'><h1 style='margin:40px 0 10px'>Aurora media</h1><p id='t' style='font-size:90px;margin:10px'>--</p><button onclick=\"document.body.style.background='%237a3b9c';this.textContent='Clicked!'\" style='font-size:48px;padding:10px 40px'>Click</button><br><input placeholder='Type here' style='font-size:44px;margin-top:30px;width:70%'><script>setInterval(function(){document.getElementById('t').textContent=new Date().toLocaleTimeString()},250)</script></body></html>" }

